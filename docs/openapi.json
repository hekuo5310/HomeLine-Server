  "components": {
    "schemas": {
      "CallResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "sip_call_id": {
            "type": "string",
            "title": "Sip Call Id"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "remote": {
            "type": "string",
            "title": "Remote"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "answered_device_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answered Device Id"
          },
          "queue_position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Queue Position"
          },
          "waiting_since": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Waiting Since"
          }
        },
        "type": "object",
        "required": [
          "id",
          "sip_call_id",
          "state",
          "remote",
          "updated_at",
          "revision",
          "answered_device_id",
          "queue_position",
          "waiting_since"
        ],
        "title": "CallResponse"
      },
      "CreateUser": {
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,80}$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "title": "Password"
          },
          "extension": {
            "type": "string",
            "pattern": "^[0-9]{2,8}$",
            "title": "Extension"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ],
            "title": "Role",
            "default": "user"
          },
          "device_limit": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Limit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password",
          "extension"
        ],
        "title": "CreateUser"
      },
      "CredentialsResponse": {
        "properties": {
          "web_socket_url": {
            "type": "string",
            "title": "Web Socket Url"
          },
          "uri": {
            "type": "string",
            "title": "Uri"
          },
          "authorization_user": {
